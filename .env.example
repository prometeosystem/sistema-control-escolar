# Database (local Docker — no es un secreto de producción)
DATABASE_URL=postgresql://sca:sca@localhost:5432/sca?schema=public

# API
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Lista separada por comas. Agregá el puerto alterno si el 3000 está ocupado.
WEB_ORIGIN=http://localhost:3000,http://localhost:3010

# Firebase Storage (service account — never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# SMTP (fallback si no hay settings en DB; el admin puede configurarlas desde /admin/smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCA <noreply@example.com>"

# Cifrado de secretos guardados en DB (SMTP password). Si falta, se usa JWT_ACCESS_SECRET.
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key-min-32

# Seed local only (required for prisma:seed — do not reuse in production)
SEED_ADMIN_EMAIL=admin@sca.local
SEED_ADMIN_PASSWORD=change-me-local-admin-password
# Opcional: si se define, el seed crea profesor@/alumno@/padre@sca.local con
# esta contraseña, ya vinculados en una clase demo. Dejar vacío fuera de local.
SEED_DEMO_PASSWORD=

# Gemini (opcional — auto-calificación de párrafos en exámenes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
