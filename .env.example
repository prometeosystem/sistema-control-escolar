# Database (local Docker — no es un secreto de producción)
DATABASE_URL=postgresql://sca:sca@localhost:5432/sca?schema=public

# API
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000

# Firebase Storage (service account — never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# SMTP (leave empty until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCA <noreply@example.com>"

# Seed local only (required for prisma:seed — do not reuse in production)
SEED_ADMIN_EMAIL=admin@sca.local
SEED_ADMIN_PASSWORD=change-me-local-admin-password

# Gemini (opcional — auto-calificación de párrafos en exámenes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
