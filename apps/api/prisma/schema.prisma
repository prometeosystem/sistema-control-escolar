// Fase 3: tareas, equipos, entregas, calificaciones y adjuntos (archivo/link).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum RoleInClass {
  teacher
  student
}

enum AssignmentMode {
  individual
  team
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
}

enum AttachmentKind {
  file
  link
}

model School {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  cycles    AcademicCycle[]
  classes   Class[]
}

model AcademicCycle {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime @db.Date
  endsAt    DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]

  @@index([schoolId])
}

model User {
  id                 String             @id @default(uuid())
  schoolId           String?
  school             School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  email              String             @unique
  passwordHash       String
  role               Role
  fullName           String
  emailNotify        Boolean            @default(true)
  inAppNotify        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  refreshTokens      RefreshToken[]
  memberships        ClassMembership[]
  posts              Post[]
  attachments        Attachment[]
  createdAssignments Assignment[]       @relation("AssignmentCreator")
  submissions        Submission[]
  teamMemberships    TeamMember[]
  gradesReceived     Grade[]            @relation("GradeStudent")
  gradesGiven        Grade[]            @relation("GradeTeacher")
  createdExams       Exam[]             @relation("ExamCreator")
  examAudience       ExamAudience[]
  examAttempts       ExamAttempt[]
  notifications      Notification[]
  emailLogs          EmailLog[]
  parentLinksAsParent  ParentLink[] @relation("ParentLinksAsParent")
  parentLinksAsStudent ParentLink[] @relation("ParentLinksAsStudent")

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Class {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycleId     String
  cycle       AcademicCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  name        String
  section     String?
  subject     String?
  joinCode    String            @unique
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships ClassMembership[]
  posts       Post[]
  assignments Assignment[]
  exams       Exam[]

  @@index([schoolId])
  @@index([cycleId])
}

model ClassMembership {
  id          String      @id @default(uuid())
  classId     String
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInClass RoleInClass
  createdAt   DateTime    @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

model Post {
  id          String       @id @default(uuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@index([classId, createdAt])
}

model Assignment {
  id          String         @id @default(uuid())
  classId     String
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String
  mode        AssignmentMode @default(individual)
  dueAt       DateTime
  maxScore    Decimal        @db.Decimal(8, 2)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  teams       Team[]
  submissions Submission[]
  grades      Grade[]
  attachments Attachment[]

  @@index([classId, dueAt])
}

model Team {
  id           String       @id @default(uuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime     @default(now())
  members      TeamMember[]
  submissions  Submission[]

  @@unique([assignmentId, name])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String?
  student      User?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(draft)
  content      String?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attachments  Attachment[]
  grade        Grade?

  @@index([assignmentId])
  @@index([studentId])
  @@index([teamId])
}

model Grade {
  id            String      @id @default(uuid())
  studentId     String
  student       User        @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId  String?     @unique
  submission    Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examAttemptId String?     @unique
  examAttempt   ExamAttempt? @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  score         Decimal     @db.Decimal(8, 2)
  maxScore      Decimal     @db.Decimal(8, 2)
  feedback      String?
  gradedById    String
  gradedBy      User        @relation("GradeTeacher", fields: [gradedById], references: [id], onDelete: Cascade)
  gradedAt      DateTime    @default(now())
  passed        Boolean?

  @@index([studentId])
  @@index([assignmentId])
}

model Attachment {
  id           String         @id @default(uuid())
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  kind         AttachmentKind @default(file)
  storagePath  String?
  bucket       String?
  externalUrl  String?
  mimeType     String
  size         Int            @default(0)
  originalName String
  postId       String?
  post         Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submissionId String?
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  examAnswerId String?
  examAnswer   ExamAnswer?    @relation(fields: [examAnswerId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@unique([storagePath])
  @@index([postId])
  @@index([assignmentId])
  @@index([submissionId])
  @@index([examAnswerId])
  @@index([uploadedById])
}

enum QuestionType {
  multiple_choice
  true_false
  short_answer
  paragraph
  file_upload
}

enum AutoGradeProvider {
  none
  gemini
}

enum ExamAttemptStatus {
  in_progress
  submitted
  graded
}

model Exam {
  id                    String            @id @default(uuid())
  classId               String
  class                 Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User              @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  timeLimitMin          Int?
  /// Puntaje máximo del intento (suma de preguntas seleccionadas o fijo)
  maxScore              Decimal           @db.Decimal(8, 2)
  /// Calificación mínima para aprobar (parametrizable)
  minPassingScore       Decimal?          @db.Decimal(8, 2)
  /// Intentos máximos (null = ilimitado)
  maxAttempts           Int?
  /// Cuántas preguntas salen en el formulario (desde el banco)
  questionsPerAttempt   Int
  shuffleQuestions      Boolean           @default(true)
  shuffleOptions        Boolean           @default(true)
  /// Si false, todos los alumnos de la clase; si true, solo ExamAudience
  restrictAudience      Boolean           @default(false)
  allowFileAnswers      Boolean           @default(true)
  showResultsToStudent  Boolean           @default(true)
  autoGradeEnabled      Boolean           @default(false)
  autoGradeProvider     AutoGradeProvider @default(none)
  /// Placeholder futuro: usar GEMINI_API_KEY del env cuando provider=gemini
  autoGradeModel        String?
  opensAt               DateTime?
  closesAt              DateTime?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  questions             ExamQuestion[]
  audience              ExamAudience[]
  attempts              ExamAttempt[]

  @@index([classId])
}

model ExamQuestion {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  order         Int          @default(0)
  type          QuestionType
  prompt        String
  /// Opciones para multiple_choice: [{ id, text }]
  options       Json?
  /// Respuesta correcta para auto-calificar (multiple_choice/true_false/short)
  correctAnswer Json?
  points        Decimal      @db.Decimal(8, 2) @default(1)
  /// Permite adjuntar archivo en la respuesta
  allowFileUpload Boolean    @default(false)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attemptItems  ExamAttemptQuestion[]
  answers       ExamAnswer[]

  @@index([examId, active])
}

model ExamAudience {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
}

model ExamAttempt {
  id          String            @id @default(uuid())
  examId      String
  exam        Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNo   Int
  status      ExamAttemptStatus @default(in_progress)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  score       Decimal?          @db.Decimal(8, 2)
  maxScore    Decimal?          @db.Decimal(8, 2)
  passed      Boolean?
  questions   ExamAttemptQuestion[]
  answers     ExamAnswer[]
  grade       Grade?

  @@unique([examId, studentId, attemptNo])
  @@index([examId, studentId])
}

model ExamAttemptQuestion {
  id         String       @id @default(uuid())
  attemptId  String
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  /// Opciones en orden mostrado al alumno (si shuffleOptions)
  optionsOrder Json?

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
}

model ExamAnswer {
  id             String       @id @default(uuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Valor de respuesta (string, boolean, optionId, texto)
  answer         Json?
  isCorrect      Boolean?
  pointsAwarded  Decimal?     @db.Decimal(8, 2)
  autoGraded     Boolean      @default(false)
  needsManualReview Boolean   @default(false)
  feedback       String?
  attachments    Attachment[]
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([attemptId, questionId])
}

enum EmailStatus {
  sent
  failed
  skipped
}

enum ParentLinkStatus {
  pending
  approved
  rejected
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model EmailLog {
  id                String      @id @default(uuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  to                String
  subject           String
  template          String
  status            EmailStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model ParentLink {
  id        String           @id @default(uuid())
  parentId  String
  parent    User             @relation("ParentLinksAsParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation("ParentLinksAsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status    ParentLinkStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([parentId, studentId])
  @@index([studentId, status])
  @@index([parentId, status])
}

/// Configuración SMTP editable por ADMIN desde el frontend (password cifrado).
model SmtpSettings {
  id                   String   @id @default(uuid())
  enabled              Boolean  @default(false)
  host                 String
  port                 Int      @default(587)
  secure               Boolean  @default(false)
  username             String?
  /// AES-256-GCM cifrado con SETTINGS_ENCRYPTION_KEY
  passwordEncrypted    String?
  fromEmail            String
  fromName             String   @default("SCA")
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
