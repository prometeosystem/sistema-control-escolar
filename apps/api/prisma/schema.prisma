// Fase 3: tareas, equipos, entregas, calificaciones y adjuntos (archivo/link).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum RoleInClass {
  teacher
  student
}

enum AssignmentMode {
  individual
  team
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
}

enum AttachmentKind {
  file
  link
}

model School {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  cycles    AcademicCycle[]
  classes   Class[]
}

model AcademicCycle {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime @db.Date
  endsAt    DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]

  @@index([schoolId])
}

model User {
  id                 String             @id @default(uuid())
  schoolId           String?
  school             School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  email              String             @unique
  passwordHash       String
  role               Role
  fullName           String
  emailNotify        Boolean            @default(true)
  inAppNotify        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  refreshTokens      RefreshToken[]
  memberships        ClassMembership[]
  posts              Post[]
  attachments        Attachment[]
  createdAssignments Assignment[]       @relation("AssignmentCreator")
  submissions        Submission[]
  teamMemberships    TeamMember[]
  gradesReceived     Grade[]            @relation("GradeStudent")
  gradesGiven        Grade[]            @relation("GradeTeacher")

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Class {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycleId     String
  cycle       AcademicCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  name        String
  section     String?
  subject     String?
  joinCode    String            @unique
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships ClassMembership[]
  posts       Post[]
  assignments Assignment[]

  @@index([schoolId])
  @@index([cycleId])
}

model ClassMembership {
  id          String      @id @default(uuid())
  classId     String
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInClass RoleInClass
  createdAt   DateTime    @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

model Post {
  id          String       @id @default(uuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@index([classId, createdAt])
}

model Assignment {
  id          String         @id @default(uuid())
  classId     String
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String
  mode        AssignmentMode @default(individual)
  dueAt       DateTime
  maxScore    Decimal        @db.Decimal(8, 2)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  teams       Team[]
  submissions Submission[]
  grades      Grade[]
  attachments Attachment[]

  @@index([classId, dueAt])
}

model Team {
  id           String       @id @default(uuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime     @default(now())
  members      TeamMember[]
  submissions  Submission[]

  @@unique([assignmentId, name])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String?
  student      User?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(draft)
  content      String?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attachments  Attachment[]
  grade        Grade?

  @@index([assignmentId])
  @@index([studentId])
  @@index([teamId])
}

model Grade {
  id           String      @id @default(uuid())
  studentId    String
  student      User        @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score        Decimal     @db.Decimal(8, 2)
  maxScore     Decimal     @db.Decimal(8, 2)
  feedback     String?
  gradedById   String
  gradedBy     User        @relation("GradeTeacher", fields: [gradedById], references: [id], onDelete: Cascade)
  gradedAt     DateTime    @default(now())

  @@index([studentId])
  @@index([assignmentId])
}

model Attachment {
  id           String         @id @default(uuid())
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  kind         AttachmentKind @default(file)
  storagePath  String?
  bucket       String?
  externalUrl  String?
  mimeType     String
  size         Int            @default(0)
  originalName String
  postId       String?
  post         Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submissionId String?
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@unique([storagePath])
  @@index([postId])
  @@index([assignmentId])
  @@index([submissionId])
  @@index([uploadedById])
}
